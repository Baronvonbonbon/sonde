{
  "name": "sonde",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "sonde — sent into a runtime to report what is there",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "verify": "node tools/verify.mjs",
    "headless": "node tools/run-headless.mjs",
    "diff": "node tools/diff-report.mjs",
    "pair": "node tools/pair-probe.mjs",
    "check-identity": "node tools/check-identity.mjs",
    "deploy": "node tools/deploy.mjs",
    "whois": "node tools/whois.mjs"
  },
  "dependencies": {
    "@parity/product-sdk": "0.27.0",
    "@parity/product-sdk-host": "0.19.1",
    "@parity/product-sdk-keys": "0.3.24",
    "@parity/product-sdk-statement-store": "0.6.9",
    "@parity/product-sdk-terminal": "0.8.2",
    "@parity/truapi": "0.13.1",
    "@polkadot-labs/hdkd-helpers": "0.0.29",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
